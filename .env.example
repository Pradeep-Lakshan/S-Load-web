# ==========================================
# OmniStream Environment Configuration
# ==========================================

# Application Port
PORT=3000

# Backend URL (used when running separate services)
BACKEND_API_URL=http://localhost:8000

# Gemini AI API Key (Required for AI Quick Video Analysis & Deep Thinking Inspector)
# Configured via Settings > Secrets in Google AI Studio
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Cloudflare Turnstile Captcha (Optional for bot abuse prevention)
# Obtain from https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Limits & Security Configuration
MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=524288000
RATE_LIMIT_RULE="15/minute"
